import {

db,

COLLECTIONS,

collection,

getDocs,

setDoc,

doc,

serverTimestamp

} from "./firebase.js";



// =======================================
// EXPORT BACKUP JSON
// =======================================

export async function backupData(){



const backup={



time:new Date().toISOString(),



teams:[],


debts:[],


salary:[],


history:[]



};



// ================================
// TEAM
// ================================


const teams=

await getDocs(

collection(

db,

COLLECTIONS.teams

)

);



teams.forEach(item=>{


backup.teams.push({


id:item.id,


...item.data()


});


});



// ================================
// DEBT
// ================================


const debts=

await getDocs(

collection(

db,

COLLECTIONS.debts

)

);



debts.forEach(item=>{


backup.debts.push({


id:item.id,


...item.data()


});


});



// ================================
// SALARY
// ================================


const salary=

await getDocs(

collection(

db,

COLLECTIONS.salary

)

);



salary.forEach(item=>{


backup.salary.push({


id:item.id,


...item.data()


});


});




// DOWNLOAD


downloadJSON(

backup,

"CUSTOM_TTA_BACKUP"

);



}



// =======================================
// DOWNLOAD JSON
// =======================================

function downloadJSON(data,name){



const blob=

new Blob(

[

JSON.stringify(

data,

null,

2

)

],

{


type:

"application/json"


}

);



const url=

URL.createObjectURL(blob);



const a=

document.createElement(

"a"

);



a.href=url;



a.download=

name+

".json";



a.click();



URL.revokeObjectURL(url);



}



// =======================================
// SAVE BACKUP ONLINE
// =======================================

export async function saveCloudBackup(){



const data={



backupTime:

serverTimestamp(),



device:

navigator.userAgent



};



await setDoc(

doc(

db,

COLLECTIONS.settings,

"backup"

),

data,

{

merge:true

}

);



}



// =======================================
// AUTO BACKUP
// =======================================

export function autoBackup(){



const last=

localStorage.getItem(

"tta_backup"

);



const today=

new Date()

.toLocaleDateString();



if(last!==today){



backupData();



localStorage.setItem(

"tta_backup",

today

);



}



}



// =======================================
// RESTORE CHECK
// =======================================

export function checkBackup(){



const file=

document.getElementById(

"restoreFile"

);



if(!file)return;



file.onchange=(e)=>{



const reader=

new FileReader();



reader.onload=()=>{



const data=

JSON.parse(

reader.result

);



localStorage.setItem(

"tta_restore",

JSON.stringify(data)

);



alert(

"✅ Đã đọc file backup"

);



};



reader.readAsText(

e.target.files[0]

);



};



}



// =======================================
// BUTTON
// =======================================


document

.getElementById(

"backupBtn"

)

?.addEventListener(

"click",

()=>{


backupData();


});



window.addEventListener(

"DOMContentLoaded",

()=>{


autoBackup();


checkBackup();


});



