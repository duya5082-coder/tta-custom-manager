// =======================================
// EXPORT EXCEL
// =======================================

export function exportExcel(){


let data=[];



// HEADER

data.push([

"STT",

"TEAM",

"BOX",

"KHUNG GIỜ",

"SLOT",

"TRẠNG THÁI",

"CTV",

"GHI CHÚ"

]);



// DATA

TEAMS.forEach((team,index)=>{


data.push([


index+1,


team.name,


team.box,


team.time,


team.slot,


team.paid

?

"Đã thanh toán"

:

"Chưa thanh toán",


team.ctv||"",


team.note||""


]);


});



// TẠO CSV

let csv=

data

.map(row=>

row.join(",")

)

.join("\n");



// DOWNLOAD

const blob=

new Blob(

[

"\ufeff"+csv

],

{

type:

"text/csv;charset=utf-8;"

}

);



const url=

URL.createObjectURL(blob);



const a=

document.createElement("a");



a.href=url;



a.download=

"CUSTOM_TTA_"+

new Date()

.toLocaleDateString()

+".csv";



a.click();



URL.revokeObjectURL(url);



}



