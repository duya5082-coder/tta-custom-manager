// firebase.rules
// BẢO MẬT FIREBASE CUSTOM TTA
// =======================================


rules_version = '2';


service cloud.firestore {


match /databases/{database}/documents {



//
// USER SESSION
//

match /users/{userId} {


allow read, write:

if request.auth != null;


}





//
// TEAM DATA
//

match /teams/{teamId} {


allow read:

if request.auth != null;



allow create, update, delete:

if request.auth != null;


}





//
// DEBT MONEY
//

match /debts/{debtId} {


allow read:

if request.auth != null;



allow create, update, delete:

if request.auth != null;


}





//
// HISTORY LOG
//

match /history/{historyId} {


allow read:

if request.auth != null;



allow create:

if request.auth != null;



allow update, delete:

if false;


}





//
// SALARY
// CHỈ ADMIN ĐƯỢC XEM
//

match /salary/{salaryId} {


allow read:

if request.auth != null

&&

request.auth.token.role == "admin";



allow write:

if request.auth != null;


}





//
// SETTINGS
//

match /settings/{settingId} {


allow read, write:

if request.auth != null;


}





// DEFAULT BLOCK

match /{document=**} {


allow read, write:

if false;


}



}

}


