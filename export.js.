import {

TEAMS

} from "./app.js";

import {

TIME_LIST

} from "./firebase.js";



// =======================================
// CREATE NOTIFICATION
// =======================================

export function createNotification(

title,

message,

type="info"

){



const area=

document.getElementById(

"notificationList"

);



if(!area)return;



const div=

document.createElement(

"div"

);



div.className=

"notificationItem";



div.innerHTML=`

<div>


<h4>

${title}

</h4>


<p>

${message}

</p>


</div>


<span>

${getIcon(type)}

</span>

`;



area.prepend(div);



// AUTO REMOVE

setTimeout(()=>{


div.remove();


},10000);



}



// =======================================
// ICON
// =======================================

function getIcon(type){



switch(type){


case "full":

return "🔥";


case "success":

return "✅";


case "warning":

return "⚠️";


case "error":

return "❌";


default:

return "🔔";


}



}



// =======================================
// CHECK FULL SLOT
// =======================================

export function checkFullSlot(){



TIME_LIST.forEach(time=>{


const teams=

TEAMS.filter(

x=>

x.time===time

);



if(teams.length>=12){



createNotification(

"🔥 FULL KHUNG GIỜ",

`${time} đã đủ 12 đội`,

"full"

);



}



});



}



// =======================================
// CHECK FULL BOX
// =======================================

export function checkFullBox(){



const boxList={};



TEAMS.forEach(team=>{



if(!boxList[team.box]){

boxList[team.box]=[];

}



boxList[team.box].push(team);



});



Object.keys(boxList)

.forEach(box=>{



if(boxList[box].length>=12){



createNotification(

"📦 BOX ĐẦY",

`BOX ${box} đã đủ 12 team`,

"full"

);



}



});



}



// =======================================
// TEAM SUCCESS
// =======================================

export function notifyTeamSuccess(team){



createNotification(

"🎮 TEAM MỚI",

`${team.name} đã đăng ký ${team.time}`,

"success"

);



}



// =======================================
// PAYMENT NOTICE
// =======================================

export function notifyPayment(team){



createNotification(

