} from "./firebase.js";


// =======================================
// ICON SLOT
// =======================================

function slotIcon(number){


const icons=[

"",

"1️⃣",

"2️⃣",

"3️⃣",

"4️⃣",

"5️⃣",

"6️⃣",

"7️⃣",

"8️⃣",

"9️⃣",

"🔟",

"1️⃣1️⃣",

"1️⃣2️⃣"

];


return icons[number]||number;


}



// =======================================
// TẠO BẢNG COPY
// =======================================

export function createMessengerText(){


let text="🔥 CUSTOM TTA 🔥\n\n";



TIME_LIST.forEach(time=>{


const teams=

TEAMS.filter(

x=>x.time===time

);



if(teams.length===0)return;



text+=

"================\n";


text+=

`⏰ ${time} ⏰ 💸5K💸\n\n`;



let table=0;



for(

let i=0;

i<teams.length;

i+=12

){



table++;



text+=

`🔥 BẢNG ${String.fromCharCode(64+table)}\n\n`;



const list=

teams.slice(

i,

i+12

);



for(

let s=1;

s<=12;

s++

){



const team=

list.find(

x=>x.slot===s

);



text+=slotIcon(s)+" ";



if(team){



text+=

team.name;



if(team.box){



text+=

` (${team.box})`;



}



if(team.paid){



text+=" 💸";



}



}else{


text+="(Trống)";


}



text+="\n";


}



text+="\n";



}



});



text+=

"📋 COPY BẢNG ĐẤU";


return text;


}



// =======================================
// COPY TO CLIPBOARD
// =======================================

export async function copyMessenger(){


const text=

createMessengerText();



await navigator.clipboard.writeText(text);



showCopyToast();



}



// =======================================
// COPY RIÊNG KHUNG GIỜ
// =======================================

export async function copyTimeTable(time){



const teams=

TEAMS.filter(

x=>x.time===time

);



let text=

`⏰ ${time} ⏰ 💸5K💸\n\n`;



let table=0;



for(

let i=0;

i<teams.length;

i+=12

){


table++;



text+=

`🔥 BẢNG ${String.fromCharCode(64+table)}\n`;



const list=

teams.slice(

i,

i+12

);



list.forEach((team,index)=>{


text+=

slotIcon(index+1)

+" "

+

team.name

+

(team.paid?" 💸":"")+

"\n";



});



text+="\n";


}



await navigator.clipboard.writeText(text);



showCopyToast();



}



// =======================================
// NÚT COPY TẤT CẢ
// =======================================

document

.getElementById(

