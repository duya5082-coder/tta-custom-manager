// =======================================
// DOWNLOAD FILE
// =======================================

function downloadFile(data,name){



let text=

data

.map(x=>

x.join(",")

)

.join("\n");



const blob=

new Blob(

[

"\ufeff"+text

],

{

type:

"text/csv"

}

);



const url=

URL.createObjectURL(blob);



const link=

document.createElement("a");



link.href=url;



link.download=

name+".csv";



link.click();



URL.revokeObjectURL(url);



}



