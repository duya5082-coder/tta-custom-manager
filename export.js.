import {

db,

COLLECTIONS,

collection,

getDocs,

deleteDoc,

doc,

setDoc,

serverTimestamp

} from "./firebase.js";

import {

todayKey

} from "./firebase.js";



// =======================================
// TIME RESET
// =======================================

const RESET_TIME = "00:00";



// =======================================
// CHECK NGÀY MỚI
// =======================================

export async function checkAutoReset(){


const lastDay=

localStorage.getItem(

"tta_last_reset"

);



const today=

todayKey();



if(lastDay!==today){



await resetAllSlot();



localStorage.setItem(

"tta_last_reset",

today

);



console.log(

"🔥 Đã reset bảng đấu ngày mới"

);



}



}



// =======================================
// RESET TEAM
// =======================================

export async function resetAllSlot(){



try{



const teamPath=

collection(

db,

COLLECTIONS.teams,

todayKey(),

"list"

);



const snap=

await getDocs(teamPath);



for(const item of snap.docs){



await deleteDoc(

doc(

teamPath,

item.id

)

);



}



// Tạo lịch sử reset

await setDoc(

doc(

db,

COLLECTIONS.settings,

"reset"

),

{


lastReset:

serverTimestamp(),


message:

"Reset slot thành công"


}


);



}catch(e){



console.error(

"Reset lỗi:",

e

);



}



}



// =======================================
// AUTO RUN
// =======================================

export function startAutoReset(){



setInterval(()=>{



const now=

new Date();



const hour=

String(

now.getHours()

)

.padStart(2,"0");



const minute=

String(

now.getMinutes()

)

.padStart(2,"0");



const time=

hour+":"+minute;



if(time===RESET_TIME){



checkAutoReset();



}



},60000);



}



// =======================================
// RESET CACHE
// =======================================

export function clearLocalData(){



localStorage.removeItem(

"tta_today_cache"

);



localStorage.removeItem(

"tta_slot"

);



}



// =======================================
// START
// =======================================

window.addEventListener(

"DOMContentLoaded",

()=>{



checkAutoReset();



startAutoReset();



});



